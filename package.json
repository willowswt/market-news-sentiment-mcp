    "mcp-server",
    "model-context-protocol",
    "yahoo-finance",
    "stocks",
    "crypto",
    "google-trends",
    "market-sentiment",
    "finance",
    "apify"
  ],
  "homepage": "https://apify.com/church_of_loujess/market-news-sentiment-mcp",
  "repository": {
